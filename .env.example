# ── OpenAI (필수) ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# 웹 검색(web_search) 도구를 지원하는 모델 권장
OPENAI_MODEL=gpt-4o-mini
# 웹 검색 on/off (true/false)
ENABLE_WEB_SEARCH=true

# ── Firebase Firestore (선택) ─────────────────────────────────
# 미설정 시: 인메모리 저장(개발용) — 서버 재시작 시 데이터 소실
# 서비스 계정 키 JSON 전체를 한 줄로 붙여넣기
FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"your-project-id",...}

# ── CORS (선택, 기본 *) ────────────────────────────────────────
ALLOWED_ORIGINS=*
