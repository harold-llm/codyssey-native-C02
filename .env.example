# Compass 환경 변수 — 이 파일을 .env로 복사해서 사용하세요 (.env는 git에 올라가지 않습니다)
# 아무 키도 넣지 않아도 '오프라인 추천'(카탈로그 규칙 기반) 모드로 실행됩니다.

# ── LLM ───────────────────────────────────────────────────────
# auto(기본): OPENROUTER_API_KEY → OpenRouter, 없으면 ANTHROPIC_API_KEY → Claude,
#             없으면 OPENAI_API_KEY → OpenAI, 모두 없으면 local
LLM_PROVIDER=auto

# OpenRouter — 키 하나로 Claude·GPT 등 사용 (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# 모델 ID는 OpenRouter 표기. 저렴하게: anthropic/claude-haiku-5.5, openai/gpt-4o-mini
OPENROUTER_MODEL=anthropic/claude-opus-5.5

# Claude (권장) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# 기본 claude-opus-5-5. 비용을 낮추려면 claude-haiku-5-5 (Bloomy 배포본과 동일)
ANTHROPIC_MODEL=claude-opus-5-5
# 생각 깊이: low | medium | high (채팅은 low로 충분, OpenRouter의 Claude 모델에도 적용)
CLAUDE_EFFORT=low

# OpenAI (선택)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 웹 검색으로 카탈로그 밖 최신 자료 보완 (true/false)
# Claude 직접 연결은 Console에서 웹 검색 허용 필요, OpenRouter는 web 플러그인 요금 별도
ENABLE_WEB_SEARCH=true

# ── 저장소 ────────────────────────────────────────────────────
# auto(기본): Firebase 키 있으면 firestore, 로컬은 file(.data/compass.json), Vercel은 memory
STORE_BACKEND=auto
# DATA_FILE=.data/compass.json

# Firebase Firestore (선택) — 서비스 계정 키 JSON 전체를 한 줄로
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── 서버 ──────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=*
