{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["backend/**", "frontend/**"] }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "backend/main.py" }
  ]
}
